# ─────────────────────────────────────────────────────────────────────────────
# PT Ekspor Arang — AI Agent System Environment Variables
# Copy this file to .env and fill in every value before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gmail SMTP (for sending emails) ──────────────────────────────────────────
# Your Gmail address used as the sender
GMAIL_ADDRESS=yourname@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Enable 2FA first, then: Google Account → Security → App Passwords
# Create for "Mail" → "Other device" → copy the 16-character password
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Gmail API (for reading inbox / reply monitoring) ─────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable Gmail API
# 3. Create OAuth 2.0 Client ID (Desktop) → Download JSON
# 4. Save as credentials.json in project root
# 5. Set path below (relative or absolute)
GMAIL_CREDENTIALS_JSON=credentials.json

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot → follow prompts
# 2. Copy the token given by BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Your personal Telegram chat ID (to receive reports)
# 1. Send any message to your bot
# 2. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find "chat" → "id" in the JSON response
TELEGRAM_CHAT_ID=123456789

# ── Company Information ───────────────────────────────────────────────────────
COMPANY_NAME=PT Ekspor Arang
COMPANY_EMAIL=export@pteksporarang.com
SENDER_NAME=Your Name

# ── Database ──────────────────────────────────────────────────────────────────
# Leave default or set custom path (directory must exist)
DB_PATH=db/crm.db
