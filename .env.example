# ─────────────────────────────────────────────────────────────────────────────
# PT Cahaya Woodchar International — AI Agent System v2.0
# Copy this file to .env and fill in every value before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: Google Gemini (Primary) ─────────────────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── LLM: Groq (Fallback — FREE, 30 RPM) ─────────────────────────────────────
# Daftar gratis di: https://console.groq.com (no credit card)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gmail SMTP (untuk kirim email) ───────────────────────────────────────────
GMAIL_ADDRESS=yourname@gmail.com
# Gmail App Password: Google Account → Security → App Passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Gmail API OAuth credentials JSON (untuk baca inbox)
GMAIL_CREDENTIALS_JSON=credentials.json

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
# @userinfobot → kirim pesan → copy id
TELEGRAM_CHAT_ID=123456789

# ── Company Info ──────────────────────────────────────────────────────────────
COMPANY_NAME=PT Cahaya Woodchar International
COMPANY_EMAIL=export@cahayawoodchar.com
SENDER_NAME=Muhammad Yahya
COMPANY_LOCATION=Lampung Utara, Lampung, Indonesia

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=db/crm.db

# ── External APIs (Phase 4) ───────────────────────────────────────────────────
# https://exchangerate-api.com → free tier 1500 req/bulan
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# ── Feature Flags ─────────────────────────────────────────────────────────────
# WhatsApp outreach (unofficial WA-JS — enable only if understood ToS risk)
WHATSAPP_ENABLED=false
# LinkedIn automation (selenium — enable only if understood ToS risk)
LINKEDIN_ENABLED=false
# Negotiation auto-approve (JANGAN diubah ke true kecuali darurat)
NEGOTIATION_AUTO_APPROVE=false
# Send time optimization berdasarkan timezone buyer
SEND_TIME_OPTIMIZE=true

# ── Operational Limits ────────────────────────────────────────────────────────
MAX_EMAILS_PER_DAY=200
MAX_TOUCHES=6
AB_TEST_PERCENTAGE=20
MAX_EMAILS_PER_DOMAIN=3
# Pause otomatis jika bounce rate melebihi angka ini (%)
BOUNCE_RATE_THRESHOLD=5
