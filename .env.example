# ─────────────────────────────────────────────────────────────────────────────
# PT Cahaya Woodchar International — AI Agent System v2.1
# Copy this file to .env and fill in every value before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM: Google Gemini (Primary) ─────────────────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── LLM: Groq (Fallback #1 — FREE, 30 RPM) ───────────────────────────────────
# Daftar gratis di: https://console.groq.com (no credit card)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM: NVIDIA (Fallback #2 — Nemotron-49B) ─────────────────────────────────
# Daftar di: https://build.nvidia.com → API Key
# Model: nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# ── Gmail SMTP (untuk kirim email) ───────────────────────────────────────────
GMAIL_ADDRESS=yourname@gmail.com
GMAIL_USER=yourname@gmail.com
# Gmail App Password: Google Account → Security → App Passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Gmail API OAuth credentials JSON (untuk baca inbox)
GMAIL_CREDENTIALS_JSON=credentials.json
# v2.1: Multi-account rotation (optional — format: email1:pass1,email2:pass2)
GMAIL_ACCOUNTS=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
# @userinfobot → kirim pesan → copy id
TELEGRAM_CHAT_ID=123456789

# ── Company Info ──────────────────────────────────────────────────────────────
COMPANY_NAME=PT Cahaya Woodchar International
COMPANY_EMAIL=johanneshaq@indonesiancharcoalsupplier.com
COO_EMAIL=johanneshaq@indonesiancharcoalsupplier.com
SENDER_NAME=Muhammad Yahya
COO_NAME=Muhammad Yahya
COMPANY_WEBSITE=https://cahayawoodchar.com
COMPANY_LOCATION=Lampung Utara, Lampung, Indonesia
WA_NUMBER_1=+62 895 0481 5988
WA_NUMBER_2=+62 812 2564 6585
WA_NUMBER_3=+62 812 2464 6585

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=db/crm.db

# ── External APIs ─────────────────────────────────────────────────────────────
# https://exchangerate-api.com → free tier 1500 req/bulan
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here
# v2.1: YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here
# v2.1: Bit.ly link tracking — https://app.bitly.com/settings/api
BITLY_ACCESS_TOKEN=your_bitly_token_here
# v2.1: TikTok ms_token (optional, reduces detection)
TIKTOK_MS_TOKEN=

# ── Feature Flags (v2.0) ──────────────────────────────────────────────────────
# WhatsApp outreach (unofficial — enable only if understood ToS risk)
WHATSAPP_ENABLED=false
# Negotiation auto-approve (JANGAN diubah ke true kecuali darurat)
NEGOTIATION_AUTO_APPROVE=false
# Send time optimization berdasarkan timezone buyer
SEND_TIME_OPTIMIZE=true

# ── Operational Limits ────────────────────────────────────────────────────────
MAX_EMAILS_PER_DAY=200
MAX_TOUCHES=6
AB_TEST_PERCENTAGE=20
MAX_EMAILS_PER_DOMAIN=3
# Pause otomatis jika bounce rate melebihi angka ini (%)
BOUNCE_RATE_THRESHOLD=5

# ── v2.1: Email Warmup ────────────────────────────────────────────────────────
# Set true jika akun Gmail baru (< 1 bulan) untuk bangun reputasi
WARMUP_MODE=false
# Tanggal mulai warmup (YYYY-MM-DD) — diisi otomatis saat pertama enable
WARMUP_START_DATE=

# ── v2.1: Social Media Scraping ───────────────────────────────────────────────
# Master switch — set true untuk enable semua social scraping
SOCIAL_SCRAPING_ENABLED=false
# Per-platform enable/disable (berlaku hanya jika SOCIAL_SCRAPING_ENABLED=true)
SOCIAL_YOUTUBE_ENABLED=true
SOCIAL_INSTAGRAM_ENABLED=false
SOCIAL_FACEBOOK_ENABLED=false
SOCIAL_TIKTOK_ENABLED=false
SOCIAL_TWITTER_ENABLED=false
SOCIAL_LINKEDIN_ENABLED=false   # Default FALSE — paling berisiko ban
# Instagram dummy account
INSTAGRAM_USERNAME=your_dummy_instagram
INSTAGRAM_PASSWORD=your_dummy_password
# LinkedIn dummy account (HIGH BAN RISK — gunakan akun dummy)
LINKEDIN_EMAIL=your_dummy_linkedin@email.com
LINKEDIN_PASSWORD=your_dummy_password
# Facebook proxy (optional — gunakan jika IP diblokir)
FACEBOOK_PROXY=

# ── v2.1: Operational Flags ───────────────────────────────────────────────────
# OFAC sanctions check (SELALU true — jangan diubah ke false)
OFAC_CHECK_ENABLED=true
# Google Drive daily backup (perlu credentials.json)
DRIVE_BACKUP_ENABLED=false
# Sample follow-up emails (7 days after shipping)
SAMPLE_FOLLOWUP_ENABLED=true
# Post-deal reorder sequence (30/60/90 days)
REORDER_SEQUENCE_ENABLED=true
# Health check server port
HEALTH_CHECK_PORT=8080

# ── v3.0: Advanced Intelligence ───────────────────────────────────────────────
# ChromaDB vector memory for lead similarity & personalization
VECTOR_MEMORY_ENABLED=true

# Email open tracking — needs public server URL (use ngrok for local dev)
# Example: https://abc123.ngrok.io  or https://yourserver.com
EMAIL_TRACKING_ENABLED=false
TRACKING_SERVER_URL=

# Churn detection (auto-identifies cold INTERESTED leads)
CHURN_DETECTION_ENABLED=true

# Competitor Alibaba price monitoring (every 6 hours)
COMPETITOR_MONITOR_ENABLED=true

# Dynamic FOB pricing engine
PRICING_ENGINE_ENABLED=true

# Revenue forecasting in daily reports
REVENUE_FORECAST_ENABLED=true

# ── v3.1: Conversation Intelligence ──────────────────────────────────────────
# Calendly booking link — inject ke proposal email (kosongkan jika belum punya)
CALENDLY_URL=

# Conversation stage tracking (COLD → QUALIFICATION → VALUE_PROP → NEGOTIATING → CLOSED)
CONV_STAGE_TRACKING=true
